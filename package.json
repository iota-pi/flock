{
  "name": "flock",
  "type": "module",
  "version": "1.0.0",
  "description": "Flock app and API",
  "author": "David Adams",
  "license": "MIT",
  "private": true,
  "scripts": {
    "analyse": "source-map-explorer 'dist/static/js/*.js'",
    "build": "tsc && vite build",
    "deploy": "sst deploy",
    "dev": "vite",
    "sst": "sst dev",
    "dev:vault": "tsx watch src/vault/api/runServer.ts",
    "initdb": "tsx src/vault/drivers/init.ts",
    "lint": "eslint src/ --ext .ts,.tsx",
    "start": "docker compose up -d && concurrently -n \"APP,API\" -c \"cyan,magenta\" \"yarn dev\" \"yarn dev:vault\"",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "cypress run"
  },
  "dependencies": {
    "@automerge/automerge": "^3.2.5",
