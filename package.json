{
  "name": "flock",
  "type": "module",
  "version": "1.0.0",
  "description": "Flock app and API",
  "author": "David Adams",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "analyse": "source-map-explorer 'dist/static/js/*.js'",
    "build": "yarn typecheck && vite build",
    "deploy": "sst deploy",
    "dev": "vite",
    "dev:vault": "tsx watch src/vault/api/runServer.ts",
    "initdb": "tsx src/vault/initdb.ts",
    "lint": "eslint src/ packages/",
    "typecheck": "tsc --noEmit && yarn workspaces foreach -A --exclude flock run typecheck",
    "start": "docker compose up -d && concurrently -n \"APP,API\" -c \"cyan,magenta\" \"yarn dev\" \"yarn dev:vault\"",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "cypress run --browser chrome"
  },
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "@automerge/automerge-repo": "2.6.0-alpha.3",
    "@automerge/automerge-repo-network-broadcastchannel": "2.6.0-alpha.3",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@fastify/auth": "^5.1.2",
    "@fastify/aws-lambda": "^6.4.2",
    "@fastify/cors": "^11.4.1",
    "@fontsource/roboto": "^5.3.0",
    "@formkit/auto-animate": "^0.10.0",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.17.0",
    "@sentry/node": "^10.46.0",
    "@sentry/react": "^10.46.0",
    "@tanstack/react-virtual": "^3.14.24",
    "@trpc/client": "^11.22.1",
    "@trpc/server": "^11.22.1",
    "@vault/client": "workspace:*",
    "@vault/server": "workspace:*",
    "@vault/shared": "workspace:*",
    "@vitejs/plugin-react": "^6.1.2",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "comlink": "^4.4.2",
    "csv-parse": "^7.0.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "fast-deep-equal": "^3.1.3",
    "fastify": "^5.12.8",
    "js-file-download": "^0.4.12",
    "localforage": "^1.10.0",
    "lodash-es": "^4.17.23",
    "match-sorter": "^8.2.0",
    "mui2-file-dropzone": "^7.1.1",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-hotkeys-hook": "^5.2.1",
    "react-icons": "^5.5.0",
    "react-router": "^8.5.1",
    "react-swipeable": "^7.0.2",
    "usehooks-ts": "^3.1.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1161.0",
    "@aws-sdk/client-sqs": "3.1161.0",
    "@aws-sdk/lib-dynamodb": "3.1161.0",
    "@eslint/js": "^10.0.1",
    "@sentry/cli": "^3.8.2",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "cypress": "^15.19.0",
    "cypress-axe": "^1.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^21.0.4",
    "knip": "^6.44.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "source-map-explorer": "^2.5.2",
    "sst": "^4.17.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.1.0",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.0"
  },
  "dependenciesMeta": {
    "cypress": {
      "built": true
    }
  },
  "packageManager": "yarn@4.15.0"
}
