/index.html
  Cache-Control: no-cache, must-revalidate

/migrate/index.html
  Cache-Control: no-cache, must-revalidate

/service-worker.js
  Cache-Control: no-cache, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Every path. The CSP is enforced, and violations go to Sentry's security endpoint. Workers get it
# from their script's response, so it covers every path. connect-src must list every API in
# src/deployments.ts (deployments.spec.ts checks). Installed apps keep the headers their service
# worker cached until it updates, so the policy can't be loosened quickly.
#
# Trusted Types only report for now, in a policy of their own. src/app/trustedTypes.ts is the default
# policy that every script-URL and HTML sink goes through. Once Sentry shows no violations, move the
# directive into the enforced CSP, with `trusted-types default` so no other policy can be made.
#
# X-Frame-Options stays for browsers that don't support frame-ancestors.
# no-referrer is safe because Sentry and tRPC use CORS fetches, which still send Origin (and Sentry
# sets its own referrerPolicy). COOP is safe because the app neither opens popups nor needs its
# opener. Permissions-Policy turns off features Flock doesn't use; WebAuthn and clipboard-write keep
# their default of 'self'. HSTS has no includeSubDomains or preload, since other cross-code.org
# hosts aren't this app's to commit to HTTPS.
/*
  Strict-Transport-Security: max-age=63072000
  Content-Security-Policy: default-src 'self'; object-src 'none'; frame-src 'none'; media-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; manifest-src 'self'; worker-src 'self'; connect-src 'self' https://api.flock.cross-code.org https://api.flock-staging.cross-code.org https://o4511115810832384.ingest.us.sentry.io; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; report-uri https://o4511115810832384.ingest.us.sentry.io/api/4511115818762240/security/?sentry_key=9165ee7e30058dda2ee3529b97cf1ae3; report-to csp
  Content-Security-Policy-Report-Only: require-trusted-types-for 'script'; report-uri https://o4511115810832384.ingest.us.sentry.io/api/4511115818762240/security/?sentry_key=9165ee7e30058dda2ee3529b97cf1ae3; report-to csp
  Reporting-Endpoints: csp="https://o4511115810832384.ingest.us.sentry.io/api/4511115818762240/security/?sentry_key=9165ee7e30058dda2ee3529b97cf1ae3"
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), bluetooth=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=()
