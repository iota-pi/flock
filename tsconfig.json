{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "src/*": [
        "./src/*"
      ]
    },
    "allowJs": true,
    "jsx": "react-jsx",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "types": [
      "node",
      "vitest/globals",
      "vite/client",
      "vite-plugin-pwa/client"
    ]
  },
  "include": [
    "src",
    "vitest.config.ts",
    "vitest.setup.ts",
    "vitest.dynamodb.ts",
    "scripts"
  ],
  "exclude": [
    "node_modules",
    "**/*.js"
  ]
}
